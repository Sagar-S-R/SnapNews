# Backend Environment Variables - Example file for production

# News API Configuration
# Get your free API key from: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Server Configuration
API_HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# Model Configuration
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-6-6
MAX_INPUT_LENGTH=1024
MAX_OUTPUT_LENGTH=150
MIN_OUTPUT_LENGTH=50

# CORS Configuration
# Add your actual Vercel frontend URL here
ALLOWED_ORIGINS=["https://your-frontend-app.vercel.app","https://*.vercel.app","http://localhost:3000","http://localhost:5173"]
